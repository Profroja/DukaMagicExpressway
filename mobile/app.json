{
  "expo": {
    "name": "SokoLink",
    "slug": "duka-magic-expressway",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sokolink",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sokolink.app"
    },
    "android": {
      "package": "com.sokolink.app",
      "adaptiveIcon": {
        "backgroundColor": "#FF5A14",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-background-task",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SokoLink uses your location to deliver your order and calculate the delivery fee."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/adaptive-icon.png",
          "color": "#FF5A14",
          "defaultChannel": "orders",
          "sounds": ["./assets/sounds/new_order.wav", "./assets/sounds/new_order_bell.wav"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF5A14",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
